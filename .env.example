# Runtime paths
EDGE_FORGE_WORKSPACE=artifacts
EDGE_FORGE_CACHE_DIR=.edge_forge_cache
EDGE_FORGE_REPORTS_DIR=reports

# Export defaults
EDGE_FORGE_DEFAULT_OPSET=17
EDGE_FORGE_DEFAULT_INPUT_SHAPE=[1, 3, 224, 224]
EDGE_FORGE_DEFAULT_PRECISION=fp32
EDGE_FORGE_SEED=42

# ONNX Runtime threading
EDGE_FORGE_INTRA_OP_THREADS=0
EDGE_FORGE_INTER_OP_THREADS=1
EDGE_FORGE_CALIBRATION_SAMPLES=16

# MCP server
EDGE_FORGE_SERVER_TRANSPORT=stdio
EDGE_FORGE_SERVER_HOST=127.0.0.1
EDGE_FORGE_SERVER_PORT=8000
EDGE_FORGE_LOG_LEVEL=INFO

# HTTP transports are disabled unless explicitly enabled. When enabled, set a
# bearer token and terminate TLS in a reverse proxy in front of the server.
EDGE_FORGE_ALLOW_NETWORK=false
EDGE_FORGE_AUTH_TOKEN=
# Per-tool deadline in seconds; zero disables it.
EDGE_FORGE_OPERATION_TIMEOUT_S=0

# MCP path confinement
EDGE_FORGE_RESTRICT_PATHS=true
# Additional allowed roots, separated by os.pathsep (";" on Windows, ":" elsewhere)
EDGE_FORGE_EXTRA_ALLOWED_ROOTS=
